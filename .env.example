# Copy to .env.local for Next; worker uses --env-file=.env.local (see README).
GROWTH_MODE=simulation
DATABASE_PATH=.data/growth.sqlite
# Exact public origin, no trailing slash; required in live.
APP_ORIGIN=http://localhost:3000
# Required for simulation login; generate unique values, never commit them.
DASHBOARD_PASSWORD=
SESSION_SECRET=
# live: requires PostgreSQL + Supabase auth; still READ ONLY
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_GRAPH_VERSION=
INSTAGRAM_ACCOUNT_ID=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_API_HOST=https://us.posthog.com
INGEST_SIGNING_SECRET=
