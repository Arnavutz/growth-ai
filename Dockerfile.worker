# syntax=docker/dockerfile:1
FROM node:24-bookworm-slim
WORKDIR /app
COPY --chown=node:node package.json package-lock.json ./
RUN --mount=type=secret,id=npm_ca \
    if [ -r /run/secrets/npm_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/npm_ca; fi; \
    NODE_USE_ENV_PROXY=1 npm ci --omit=dev --fetch-timeout=30000 --fetch-retries=1 && npm cache clean --force
COPY --chown=node:node lib ./lib
COPY --chown=node:node scripts ./scripts
COPY --chown=node:node migrations ./migrations
COPY --chown=node:node tsconfig.json ./
ENV NODE_ENV=production
USER node
CMD ["node", "--import", "tsx", "scripts/worker.ts"]
